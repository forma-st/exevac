# URL de connexion PostgreSQL (Neon, Supabase… ou Postgres local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exevac"
# Secret de session : 32+ caractères aléatoires en production
SESSION_SECRET="changez-moi-avec-une-longue-chaine-aleatoire"
# Facultatif : accès en lecture seule aux rapports pour le logiciel de gestion de formation (24 caractères minimum)
EVACUATION_API_TOKEN=""
# Accès : par défaut l'appli s'ouvre sans connexion. Mettre 1 pour exiger un compte (connexion privée).
REQUIRE_LOGIN=""

# ---- Envoi des rapports par e-mail (facultatif). Sans ces variables, l'appli ne propose pas l'envoi. ----
# Expéditeur affiché, par exemple : FORMAST <rapports@votre-domaine.fr>
EMAIL_FROM=""
# Option A — une boîte e-mail existante (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Option B — le service Resend (à la place du SMTP)
RESEND_API_KEY=""
# Facultatif : adresse(s) en copie de chaque envoi, et adresse de réponse
EMAIL_COPY_TO=""
EMAIL_REPLY_TO=""
